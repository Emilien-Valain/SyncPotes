{
  "name": "syncpotes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "db:setup": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "prepare": "husky || true",
    "semgrep": "semgrep --config .semgrep.yml --config p/typescript --error --skip-unknown-extensions --exclude=docs/semgrep-canaries",
    "semgrep:canary": "semgrep --config .semgrep.yml --metrics=off --json -q docs/semgrep-canaries | node scripts/check-canaries.mjs"
  },
  "dependencies": {
    "effect": "^3.12.0",
    "next": "15.5.22",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.22",
    "husky": "9.1.7",
    "lint-staged": "^15.5.2",
    "tsx": "^4.23.1",
    "typescript": "5.7.3"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "postcss": "^8.5.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  }
}
