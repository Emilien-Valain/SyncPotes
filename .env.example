# SyncPotes environment (backend).
# Google OAuth — server-side only; the client secret must never reach the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Postgres (Poll + participants + free_slots; auto-expires 7 days after a Poll's window).
DATABASE_URL=

# Shared secret for the /api/cron/cleanup endpoint (Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=
