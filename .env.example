# SyncPotes environment (backend). See docs/deployment.md for where each value
# comes from, both locally and on Vercel.

# Google OAuth — server-side only; the client secret must never reach the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google Cloud console.
# In production this is https://<your-domain>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Postgres (Poll + participants + free_slots; auto-expires 7 days after a Poll's
# window). Use the POOLED connection string — every warm instance holds its own
# pool. On Vercel the Neon integration writes this variable for you.
DATABASE_URL=

# Shared secret for the /api/cron/cleanup endpoint (Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`). Generate with: openssl rand -base64 32
CRON_SECRET=
