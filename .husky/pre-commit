#!/usr/bin/env sh
# Lint staged TS/TSX, then run Semgrep on the whole tree.
#
# Semgrep is optional locally: if it isn't installed we skip it rather than block
# the commit. The backstop is .github/workflows/ci.yml, whose `policy` job runs
# it unconditionally on every push and PR. Note the local consequence — a machine
# without Semgrep gets a green commit with zero policy enforcement, so treat the
# skip notice below as "unprotected", not "clean".
#
# Install (Arch/PEP 668 blocks plain `pip install --user`):
#   uv tool install semgrep      # or: pipx install semgrep

npx --no-install lint-staged || exit 1

if command -v semgrep >/dev/null 2>&1; then
  # The canary check runs first and is the cheaper signal: if a rule stopped
  # matching its own deliberate violation, the scan below is meaningless.
  npm run --silent semgrep:canary || exit 1
  npm run --silent semgrep || exit 1
else
  echo "⚠ semgrep not found — SKIPPING all policy checks (install: uv tool install semgrep)"
fi
